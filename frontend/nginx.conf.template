map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Документы принимаются до 5 МБ (backend/materials.py); по умолчанию nginx режет тело на 1 МБ.
        client_max_body_size 6m;
    }

    location /ws {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        # Ходы агента идут минутами; без этого nginx закроет тихий сокет через 60 с.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Рабочее пространство web-product (контракт V2) и панель администратора (#admin).
    location /product/ {
        try_files $uri $uri/ /product/index.html;
    }

    # Свободный чат — страница #chat интерфейса CoreTeams; прежний адрес /chat/ ведёт туда.
    location /chat/ {
        # Относительный Location: за пробросом порта (5173 -> 80) nginx не знает внешний порт.
        absolute_redirect off;
        return 302 /#chat;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
