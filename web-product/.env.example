# Contract V2 is served by the CoreTeams backend at /api/v2 of the same origin (default).
# Set an absolute URL only for a different origin; cross-origin auth/CORS is not set up.
VITE_CTF_API_URL=
# false switches the workspace back to local-only drafts.
VITE_CTF_V2_ENABLED=true
# Public build label, never credentials. Used only in opted-in local study exports.
VITE_BUILD_VERSION=0.2.0
# Set to fixture ONLY on an isolated synthetic test server; blocks result comparison.
VITE_RESEARCH_ENV=
