# Пароль Postgres для docker compose (сервис db). Скопируйте в .env и задайте свой.
POSTGRES_PASSWORD=
# Порт Postgres на 127.0.0.1 хоста.
# POSTGRES_PORT=5432
# Ключи S3-хранилища файлов агента (сервис s3, SeaweedFS). Задайте свои.
S3_ACCESS_KEY=coreteams
S3_SECRET_KEY=
# Порт S3 на 127.0.0.1 хоста.
# S3_PORT=8333
