# Copy to .env.gateway only on the deployment host; do not commit that file.
ANTHROPIC_BASE_URL=https://provider.example/anthropic
ANTHROPIC_AUTH_TOKEN=replace-in-secret-store
ANTHROPIC_DEFAULT_FABLE_MODEL=replace-with-approved-model
ANTHROPIC_DEFAULT_OPUS_MODEL=replace-with-approved-model
ANTHROPIC_DEFAULT_SONNET_MODEL=replace-with-approved-model
ANTHROPIC_DEFAULT_HAIKU_MODEL=replace-with-approved-model
CLAUDE_CODE_SUBAGENT_MODEL=replace-with-approved-model
# Current release base uses SQLite. Do not substitute PostgreSQL until its driver and migrations are accepted.
DATABASE_URL=sqlite+aiosqlite:///./backend/data/history.db
CLAUDE_PERMISSION_MODE=acceptEdits
ARTIFACT_MAX_DOWNLOAD_BYTES=10485760
WORKSPACE_ROOT=/home/node/.claude-web/workspaces
SUBSCRIPTION_WINDOW_SECONDS=15
SUBSCRIPTION_POLL_INTERVAL_SECONDS=0.25
MAX_CONCURRENT_RUNS=4
RUNNER_CONTEXT_HOST_DIR=/srv/coreteams/context
RUNNER_IDLE_TIMEOUT_SECONDS=600
RUNNER_VOLUME_RETENTION_SECONDS=2592000
